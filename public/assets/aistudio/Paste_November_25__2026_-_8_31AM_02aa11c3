      const jk = els.filterJk.value;
      const agm = els.filterAgama.value;
      const q = els.searchInput.value.trim().toLowerCase();

      return allStudents.filter(s => {
        if (kls !== 'ALL' && s.kelas !== kls) return false;
        if (jk !== 'ALL' && s.jk !== jk) return false;
        if (agm !== 'ALL' && s.agama !== agm) return false;
        if (q) {
          const hay = `${s.nis} ${s.nisn} ${s.nama} ${s.tempat_lahir} ${s.kelas}`.toLowerCase();
          if (!hay.includes(q)) return false;
        }
        return true;
      });
    }

    function groupStudents(list, mode) {
      if (mode === 'none') {
        return [{ key: 'ALL', label: 'Semua Peserta Didik (Terfilter)', items: list }];
      }

      const map = new Map();
      for (const s of list) {
        let key = '';
        let label = '';
        if (mode === 'kelas') {
          key = s.kelas || 'Tanpa Kelas';
          label = `Kelompok Kelas: ${key}`;
        } else if (mode === 'jk') {
          key = s.jk || 'Tidak Diketahui';
          label = s.jk === 'L'
            ? 'Kelompok Jenis Kelamin: Laki-laki (L)'
            : s.jk === 'P'
              ? 'Kelompok Jenis Kelamin: Perempuan (P)'
              : `Kelompok Jenis Kelamin: ${key}`;
        } else if (mode === 'kelas_jk') {
          key = `${s.kelas || 'Tanpa Kelas'} — ${s.jk || '-'}`;
          const jkText = s.jk === 'L' ? 'Laki-laki (L)' : s.jk === 'P' ? 'Perempuan (P)' : (s.jk || '-');
          label = `${s.kelas || 'Tanpa Kelas'} • ${jkText}`;
        } else if (mode === 'agama') {
          key = s.agama || 'Tidak Tercatat';
          label = `Kelompok Agama: ${key}`;
        }

        if (!map.has(key)) {
          map.set(key, { key, label, items: [] });
        }
        map.get(key).items.push(s);
      }

      const groups = [...map.values()];
      groups.sort((a, b) => a.key.localeCompare(b.key, 'id', { numeric: true }));
      return groups;
    }

    function escapeHtml(str) {
      return String(str ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function updateKpis(filtered) {
      const total = filtered.length;
      const lCount = filtered.filter(s => s.jk === 'L').length;
      const pCount = filtered.filter(s => s.jk === 'P').length;
      const emptyNisn = filtered.filter(s => !s.nisn || s.nisn.trim() === '').length;
      const uniqueKelas = new Set(filtered.map(s => s.kelas).filter(Boolean)).size;

      els.kpiTotal.textContent = total.toLocaleString('id-ID');
      els.kpiSubTotal.textContent = `${uniqueKelas} Rombongan Belajar`;
      els.kpiL.textContent = lCount.toLocaleString('id-ID');
      els.kpiLPct.textContent = total ? `${((lCount / total) * 100).toFixed(1)}% dari total` : '0.0% dari total';
      els.kpiP.textContent = pCount.toLocaleString('id-ID');
      els.kpiPPct.textContent = total ? `${((pCount / total) * 100).toFixed(1)}% dari total` : '0.0% dari total';
      els.kpiEmptyNisn.textContent = emptyNisn.toLocaleString('id-ID');
    }

    function render() {
      const filtered = getFilteredStudents();
      updateKpis(filtered);

      const groupBy = els.groupBySelect.value;
      const groups = groupStudents(filtered, groupBy);

      if (groups.length === 0 || filtered.length === 0) {
        els.groupsContainer.innerHTML = `
          <div class="text-center py-12 bg-slate-50 rounded-xl border border-dashed border-slate-300">
            <p class="text-sm font-semibold text-slate-700">Tidak ada data siswa yang cocok dengan filter saat ini.</p>
            <p class="text-xs text-slate-500 mt-1">Klik "Reset Filter" untuk menampilkan kembali seluruh peserta didik.</p>
          </div>
        `;
        return;
      }

      els.groupsContainer.innerHTML = groups.map((grp, idx) => {
        const lCnt = grp.items.filter(x => x.jk === 'L').length;
        const pCnt = grp.items.filter(x => x.jk === 'P').length;
        const semiText = buildSemiBlock(grp.items, true);

        const tableHtml = (viewMode === 'both' || viewMode === 'table') ? `
          <div class="overflow-x-auto rounded-xl border border-slate-200">
            <table class="min-w-full text-left border-collapse text-xs">
              <thead>
                <tr class="bg-blue-950 text-white">
                  <th class="py-2.5 px-3 font-semibold text-center w-12">No</th>
                  <th class="py-2.5 px-3 font-semibold">NIS</th>
                  <th class="py-2.5 px-3 font-semibold">NISN</th>
                  <th class="py-2.5 px-3 font-semibold">Nama Lengkap</th>
                  <th class="py-2.5 px-3 font-semibold text-center w-14">L/P</th>
                  <th class="py-2.5 px-3 font-semibold">Tempat Lahir</th>
                  <th class="py-2.5 px-3 font-semibold text-center">Tanggal Lahir</th>
                  <th class="py-2.5 px-3 font-semibold text-center">Kelas</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                ${grp.items.map((s, i) => `
                  <tr class="${i % 2 === 1 ? 'bg-slate-50/80' : 'bg-white'} hover:bg-blue-50/60">
                    <td class="py-2 px-3 text-center text-slate-500 font-medium">${i + 1}</td>
                    <td class="py-2 px-3 font-code text-slate-800">${escapeHtml(s.nis)}</td>
                    <td class="py-2 px-3 font-code ${s.nisn ? 'text-slate-800' : 'text-amber-600 font-semibold'}">${escapeHtml(s.nisn || '(Kosong)')}</td>
                    <td class="py-2 px-3 font-semibold text-slate-900">${escapeHtml(s.nama)}</td>
                    <td class="py-2 px-3 text-center">
                      <span class="inline-block px-2 py-0.5 rounded-full text-[11px] font-bold ${s.jk === 'L' ? 'bg-blue-100 text-blue-800' : 'bg-pink-100 text-pink-800'}">
                        ${escapeHtml(s.jk)}
                      </span>
                    </td>
                    <td class="py-2 px-3 text-slate-700">${escapeHtml(s.tempat_lahir)}</td>
                    <td class="py-2 px-3 text-center font-code text-slate-700">${escapeHtml(s.tanggal_lahir)}</td>
                    <td class="py-2 px-3 text-center font-semibold text-blue-900">${escapeHtml(s.kelas)}</td>
                  </tr>
                `).join('')}
              </tbody>
            </table>
          </div>
        ` : '';

        const semiHtml = (viewMode === 'both' || viewMode === 'semicolon') ? `
          <div class="mt-4">
            <div class="flex items-center justify-between gap-2 mb-1.5">
              <span class="text-xs font-bold text-slate-700">
                Format Titik Koma (;) — ${escapeHtml(grp.label)} (${grp.items.length} baris data + 1 header)
              </span>
              <button type="button" data-copy-idx="${idx}" class="copy-group-btn no-print px-2.5 py-1 rounded-md bg-slate-800 hover:bg-slate-700 text-white text-[11px] font-semibold transition">
                Salin Blok (;)
              </button>
            </div>
            <pre data-semi-idx="${idx}" class="font-code text-[11px] leading-relaxed bg-slate-950 text-emerald-300 rounded-xl p-3.5 overflow-x-auto max-h-60 border border-slate-800">${escapeHtml(semiText)}</pre>
          </div>
        ` : '';

        return `
          <article class="${idx > 0 ? 'print-break' : ''} space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 bg-blue-50 border border-blue-200 rounded-xl px-4 py-3">
              <div>
                <h3 class="text-sm sm:text-base font-bold text-blue-950">${escapeHtml(grp.label)}</h3>
                <p class="text-xs text-blue-800">
                  Jumlah: <strong>${grp.items.length}</strong> siswa • Laki-laki (L): <strong>${lCnt}</strong> • Perempuan (P): <strong>${pCnt}</strong>
                </p>
              </div>
              <div class="flex items-center gap-2 no-print">
                <button type="button" data-copy-idx="${idx}" class="copy-group-btn px-3 py-1.5 rounded-lg bg-blue-900 hover:bg-blue-800 text-white text-xs font-semibold transition">
                  Salin (;) Kelompok
                </button>
                <button type="button" data-csv-idx="${idx}" class="csv-group-btn px-3 py-1.5 rounded-lg bg-white hover:bg-blue-100 text-blue-950 border border-blue-300 text-xs font-semibold transition">
                  Unduh CSV (;)
                </button>
              </div>
            </div>
            ${tableHtml}
            ${semiHtml}
          </article>
        `;
      }).join('');

      // Attach group copy & CSV handlers
      document.querySelectorAll('.copy-group-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          const gIdx = Number(btn.getAttribute('data-copy-idx'));
          const text = buildSemiBlock(groups[gIdx].items, true);
          await copyTextToClipboard(text, `Tersalin: format (;) ${groups[gIdx].label}`);
        });
      });

      document.querySelectorAll('.csv-group-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const gIdx = Number(btn.getAttribute('data-csv-idx'));
          const safeName = groups[gIdx].key.replace(/[^a-zA-Z0-9_-]+/g, '_');
          downloadFile(buildSemiBlock(groups[gIdx].items, true), `SMPN7_${safeName}.csv`, 'text/csv;charset=utf-8;');
          showToast(`CSV diunduh: SMPN7_${safeName}.csv`);
        });
      });
    }

    async function copyTextToClipboard(text, successMsg) {
      try {
        await navigator.clipboard.writeText(text);
        showToast(successMsg);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        showToast(successMsg);
      }
    }

    function downloadFile(content, filename, mimeType) {
      const bom = mimeType.includes('csv') ? '﻿' : '';
      const blob = new Blob([bom + content], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function exportXlsx() {
      const filtered = getFilteredStudents();
      const rows = filtered.map((s, i) => ({
        No: i + 1,
        NIS: s.nis,
        NISN: s.nisn,
        'Nama Lengkap': s.nama,
        'L/P': s.jk,
        'Tempat Lahir': s.tempat_lahir,
        'Tanggal Lahir': s.tanggal_lahir,
        Kelas: s.kelas,
        Format_TitikKoma: studentToSemiRow(s)
      }));
      const ws = XLSX.utils.json_to_sheet(rows);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, ws, 'Data_Siswa');
      XLSX.writeFile(wb, 'Data_Siswa_SMPN7_Sentani.xlsx');
      showToast('Berkas Excel (.xlsx) berhasil diunduh.');
    }

    // Parse uploaded CSV (;) or Dapodik XLS/XLSX
    function handleFileUpload(file) {
      if (!file) return;
      const ext = file.name.split('.').pop().toLowerCase();
      const reader = new FileReader();

      reader.onload = (e) => {
        try {
          if (ext === 'csv') {
            const text = String(e.target.result || '');
            const lines = text.split(/
?
/).map(l => l.trim()).filter(Boolean);
            const parsed = [];
            for (let i = 0; i < lines.length; i++) {
              const parts = lines[i].split(';').map(p => p.trim());
              if (i === 0 && parts[0].toUpperCase() === 'NIS' && parts[1]?.toUpperCase() === 'NISN') continue;
              if (parts.length >= 3) {
                parsed.push({
                  nis: parts[0] || '',
                  nisn: parts[1] || '',
                  nama: parts[2] || '',
                  jk: parts[3] || '',
                  tempat_lahir: parts[4] || '',
                  tanggal_lahir: parts[5] || '',
                  kelas: parts[6] || '',
                  agama: parts[7] || '',
                  kecamatan: parts[8] || ''
                });
              }
            }
            if (!parsed.length) throw new Error('CSV kosong atau tidak sesuai format.');
            allStudents = parsed;
          } else {
            const data = new Uint8Array(e.target.result);
            const wb = XLSX.read(data, { type: 'array' });
            const firstSheet = wb.Sheets[wb.SheetNames[0]];
            const matrix = XLSX.utils.sheet_to_json(firstSheet, { header: 1, defval: '' });

            // Check if Dapodik format (row index 4 has 'Nama' and 'NIPD')
            const isDapodik = matrix[4] && String(matrix[4][1] || '').trim().toLowerCase() === 'nama';
            const parsed = [];

            if (isDapodik) {
              for (let r = 6; r < matrix.length; r++) {
                const row = matrix[r];
                const nama = String(row[1] || '').trim();
                if (!nama) continue;
                parsed.push({
                  nis: String(row[2] || '').trim(),
                  nisn: String(row[4] || '').trim(),
                  nama,
                  jk: String(row[3] || '').trim(),
                  tempat_lahir: String(row[5] || '').trim(),
                  tanggal_lahir: String(row[6] || '').trim(),
                  kelas: String(row[42] || '').trim(),
                  agama: String(row[8] || '').trim(),
                  kecamatan: String(row[14] || '').trim()
                });
              }
            } else {
              for (let r = 1; r < matrix.length; r++) {
                const row = matrix[r];
                const nama = String(row[2] || row[1] || '').trim();
                if (!nama) continue;
                parsed.push({
                  nis: String(row[0] || '').trim(),
                  nisn: String(row[1] || '').trim(),
                  nama,
                  jk: String(row[3] || '').trim(),
                  tempat_lahir: String(row[4] || '').trim(),
                  tanggal_lahir: String(row[5] || '').trim(),
                  kelas: String(row[6] || '').trim(),
                  agama: '',
                  kecamatan: ''
                });
              }
            }
            if (!parsed.length) throw new Error('Tidak ada baris siswa ditemukan pada berkas.');
            allStudents = parsed;
          }

          populateFilterOptions();
          render();
          showToast(`Berhasil memuat ${allStudents.length} data siswa dari ${file.name}.`);
        } catch (err) {
          showToast(`Gagal membaca berkas: ${err.message}`, true);
        }
      };

      if (ext === 'csv') {
        reader.readAsText(file, 'UTF-8');
      } else {
        reader.readAsArrayBuffer(file);
      }
    }

    // Event Listeners
    document.querySelectorAll('.mode-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        viewMode = btn.getAttribute('data-mode');
        document.querySelectorAll('.mode-btn').forEach(b => {
          b.className = 'mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-700 hover:text-blue-950 transition';
        });
        btn.className = 'mode-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-blue-900 text-white shadow-sm transition';
        render();
      });
    });

    [els.groupBySelect, els.filterKelas, els.filterJk, els.filterAgama].forEach(el => {
      el.addEventListener('change', render);
    });

    els.searchInput.addEventListener('input', render);

    els.btnClearFilters.addEventListener('click', () => {
      els.filterKelas.value = 'ALL';
      els.filterJk.value = 'ALL';
      els.filterAgama.value = 'ALL';
      els.searchInput.value = '';
      els.groupBySelect.value = 'kelas';
      render();
      showToast('Filter dikembalikan ke pengaturan awal.');
    });

    els.btnResetData.addEventListener('click', () => {
      allStudents = structuredClone(INITIAL_STUDENTS);
      els.fileInput.value = '';
      populateFilterOptions();
      render();
      showToast('Data dikembalikan ke daftar awal 250 siswa SMP Negeri 7 Sentani.');
    });

    els.fileInput.addEventListener('change', (e) => {
      handleFileUpload(e.target.files?.[0]);
    });

    els.btnCopyAllSemi.addEventListener('click', async () => {
      const filtered = getFilteredStudents();
      await copyTextToClipboard(
        buildSemiBlock(filtered, true),
        `Tersalin ${filtered.length} baris format (;) ke clipboard.`
      );
    });

    els.btnDownloadCsv.addEventListener('click', () => {
      const filtered = getFilteredStudents();
      downloadFile(buildSemiBlock(filtered, true), 'Data_Siswa_SMPN7_Sentani.csv', 'text/csv;charset=utf-8;');
      showToast(`CSV (${filtered.length} siswa) berhasil diunduh.`);
    });

    els.btnDownloadXlsx.addEventListener('click', exportXlsx);
    els.btnPrint.addEventListener('click', () => window.print());

    // Initial boot
    populateFilterOptions();
    render();
  </script>
</body>
</html>
