    const HEADER_LINE = "NIS;NISN;Nama Lengkap;L/P;Tempat Lahir;Tanggal Lahir;Kelas";

    function showToast(msg, isError = false) {
      els.statusToast.textContent = msg;
      els.statusToast.className = `text-xs font-semibold h-5 ${isError ? 'text-rose-600' : 'text-emerald-700'}`;
      clearTimeout(showToast._t);
      showToast._t = setTimeout(() => {
        els.statusToast.textContent = '';
      }, 3200);
    }

    function studentToSemiRow(s) {
      return [
        s.nis || '',
        s.nisn || '',
        s.nama || '',
        s.jk || '',
        s.tempat_lahir || '',
        s.tanggal_lahir || '',
        s.kelas || ''
      ].join(';');
    }

    function buildSemiBlock(list, includeHeader = true) {
      const rows = list.map(studentToSemiRow);
      return includeHeader ? [HEADER_LINE, ...rows].join('
') : rows.join('
');
    }

    function populateFilterOptions() {
      const currentKelas = els.filterKelas.value;
      const currentAgama = els.filterAgama.value;

      const kelasSet = [...new Set(allStudents.map(s => s.kelas).filter(Boolean))].sort();
      const agamaSet = [...new Set(allStudents.map(s => s.agama).filter(Boolean))].sort();

      els.filterKelas.innerHTML = '<option value="ALL">Semua Kelas</option>' +
        kelasSet.map(k => `<option value="${escapeHtml(k)}">${escapeHtml(k)}</option>`).join('');

      els.filterAgama.innerHTML = '<option value="ALL">Semua Agama</option>' +
        agamaSet.map(a => `<option value="${escapeHtml(a)}">${escapeHtml(a)}</option>`).join('');

      if (kelasSet.includes(currentKelas)) els.filterKelas.value = currentKelas;
      if (agamaSet.includes(currentAgama)) els.filterAgama.value = currentAgama;
    }

